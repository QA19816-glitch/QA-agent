#!/bin/sh

set -eu

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
keychain_service="${ONE2ALL_KEYCHAIN_SERVICE:-codex-one2all-api-token}"
keychain_account="${ONE2ALL_KEYCHAIN_ACCOUNT:-one2all-api}"
security_bin="${ONE2ALL_KEYCHAIN_SECURITY_BIN:-security}"
api_token_stdin=0
check_only=0

usage() {
  printf '%s\n' 'Usage: one2all-setup --api-token-stdin' >&2
  printf '%s\n' '       one2all-setup --check' >&2
  exit 64
}

fail() {
  printf 'One2All setup failed: %s\n' "$1" >&2
  exit "${2:-1}"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --api-token-stdin)
      api_token_stdin=1
      shift
      ;;
    --check)
      check_only=1
      shift
      ;;
    *)
      usage
      ;;
  esac
done

[ "$api_token_stdin" -eq 1 ] || [ "$check_only" -eq 1 ] || usage

command -v node >/dev/null 2>&1 || fail 'node is not installed' 69
sh -n "${script_dir}/one2all-submit" || fail 'one2all-submit has invalid shell syntax' 65
node --check "${script_dir}/one2all-submit-api.mjs" || fail 'one2all-submit-api.mjs has invalid JavaScript syntax' 65

if [ "$api_token_stdin" -eq 1 ]; then
  command -v "$security_bin" >/dev/null 2>&1 || fail 'macOS security command is not available' 69
  if [ -t 0 ]; then
    stty -echo
    trap 'stty echo' EXIT HUP INT TERM
    IFS= read -r api_token
    stty echo
    trap - EXIT HUP INT TERM
    printf '\n' >&2
  else
    IFS= read -r api_token
  fi
  [ -n "$api_token" ] || fail 'API token is empty' 65
  "$security_bin" add-generic-password -U -s "$keychain_service" -a "$keychain_account" -w "$api_token" >/dev/null
  unset api_token
  printf '%s\n' 'One2All API token saved in macOS Keychain.'
fi

if [ "$check_only" -eq 1 ]; then
  if [ -n "${ONE2ALL_API_TOKEN:-}" ] || [ -n "${ONE2ALL_API_AUTH_HEADER:-}" ]; then
    printf '%s\n' 'One2All API setup check passed.'
    exit 0
  fi
  if command -v "$security_bin" >/dev/null 2>&1 && "$security_bin" find-generic-password -s "$keychain_service" -w >/dev/null 2>&1; then
    printf '%s\n' 'One2All API setup check passed (macOS Keychain).'
    exit 0
  fi
  fail 'save a token with --api-token-stdin or configure a private API token variable' 78
fi
