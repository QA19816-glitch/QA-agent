#!/bin/sh

set -eu

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

command -v node >/dev/null 2>&1 || {
  printf '%s\n' '{"ok":false,"error":"node is required for One2All API submission"}' >&2
  exit 69
}

if [ -z "${ONE2ALL_API_TOKEN:-}" ] && [ -z "${ONE2ALL_API_AUTH_HEADER:-}" ]; then
  keychain_service="${ONE2ALL_KEYCHAIN_SERVICE:-codex-one2all-api-token}"
  security_bin="${ONE2ALL_KEYCHAIN_SECURITY_BIN:-security}"
  if command -v "$security_bin" >/dev/null 2>&1; then
    keychain_token="$("$security_bin" find-generic-password -s "$keychain_service" -w 2>/dev/null || true)"
    if [ -n "$keychain_token" ]; then
      ONE2ALL_API_TOKEN="$keychain_token"
      export ONE2ALL_API_TOKEN
      unset keychain_token
    fi
  fi
fi

exec node "${script_dir}/one2all-submit-api.mjs" "$@"
