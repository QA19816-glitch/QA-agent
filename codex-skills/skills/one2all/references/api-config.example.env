ONE2ALL_BASE_URL=https://pm-prod.vibeworld.top
# Defaults to ${ONE2ALL_BASE_URL}/api/v1/platform.
# ONE2ALL_API_BASE_URL=https://pm-prod.vibeworld.top/api/v1/platform
# Verified local default. Override only when submitting to another workspace.
ONE2ALL_API_WORKSPACE_ID=2
ONE2ALL_API_CREATE_PATH=/quality/bugs
ONE2ALL_API_LIST_PATH=/quality/bugs
ONE2ALL_API_DETAIL_PATH=/quality/bugs/{id}
ONE2ALL_API_UPLOAD_PATH=/quality/bugs/materials/upload
ONE2ALL_API_REQUIREMENT_LOOKUP_PATH=/project-requirement-scope-options
ONE2ALL_UI_PATH=/workspace/quality-management
ONE2ALL_API_PERSISTENCE_DELAY_MS=350

# The submit wrapper reads this macOS Keychain service when no token variable is set.
ONE2ALL_KEYCHAIN_SERVICE=codex-one2all-api-token

# Browser fallback only. Set to /one2all for the legacy internal deployment.
# ONE2ALL_BROWSER_APP_PREFIX=/one2all

# Configure exactly one runtime option, or save the token in macOS Keychain with
# scripts/one2all-setup --api-token-stdin.
# ONE2ALL_API_TOKEN=replace-with-local-secret
# ONE2ALL_API_AUTH_HEADER=Authorization: Bearer replace-with-local-secret
