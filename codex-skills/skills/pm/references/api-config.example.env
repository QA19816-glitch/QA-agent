PM_BASE_URL=https://pm-prod.vibeworld.top
# Defaults to ${PM_BASE_URL}/api/v1/platform.
# PM_API_BASE_URL=https://pm-prod.vibeworld.top/api/v1/platform
# Verified local default. Override only when submitting to another workspace.
PM_API_WORKSPACE_ID=2
PM_API_CREATE_PATH=/quality/bugs
PM_API_LIST_PATH=/quality/bugs
PM_API_DETAIL_PATH=/quality/bugs/{id}
PM_API_UPLOAD_PATH=/quality/bugs/materials/upload
PM_API_REQUIREMENT_LOOKUP_PATH=/project-requirement-scope-options
PM_UI_PATH=/workspace/quality-management
PM_API_PERSISTENCE_DELAY_MS=350

# The submit wrapper reads this macOS Keychain service when no token variable is set.
PM_KEYCHAIN_SERVICE=codex-pm-api-token

# Configure exactly one runtime option, or save the token in macOS Keychain with
# scripts/pm-setup --api-token-stdin.
# PM_API_TOKEN=replace-with-local-secret
# PM_API_AUTH_HEADER=Authorization: Bearer replace-with-local-secret
